# Copy to .env.prod on the VDS and adjust values.
# Keep .env.prod only on the server; do not commit real passwords.

# Caddy public listener.
# Use ":80" for first launch by IP. Use "maps.example.com" for HTTPS by domain.
SITE_HOST=:80

# Public browser URL without trailing slash.
# Examples:
#   http://203.0.113.10
#   https://maps.example.com
PUBLIC_BASE_URL=http://YOUR_SERVER_IP

POSTGRES_DB=masks
POSTGRES_USER=masks
POSTGRES_PASSWORD=change-me-long-random-password

# Most VDS providers are linux/amd64. For arm64 hosts use:
# POSTGIS_IMAGE=imresamu/postgis-arm64:16-3.6-alpine
POSTGIS_IMAGE=postgis/postgis:16-3.4

# Optional: resource-friendly defaults for one VDS.
POSTGRES_PORT=5432

# Caddy persistent volumes keep certificates when SITE_HOST is a domain.
# No extra settings are required for local HTTP mode.
