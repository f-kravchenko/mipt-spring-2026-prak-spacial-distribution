# Внешний reverse-proxy (фронт-VPS) для spatial-masks.
# TLS терминируется здесь; внутрь идёт на реальное tailnet-имя ноды
# rsp-main.tailebc04e.ts.net (оно резолвится через MagicDNS).
# Маршрутизация в кластере — по Host-заголовку: ingress.host = deaggr.kravchenko.cloud,
# поэтому Host сохраняем равным публичному домену.

server {
    listen 80;
    server_name deaggr.kravchenko.cloud;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name deaggr.kravchenko.cloud;

    ssl_certificate     /etc/letsencrypt/live/deaggr.kravchenko.cloud/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/deaggr.kravchenko.cloud/privkey.pem;

    client_max_body_size 0;            # тайлы/загрузки без лимита

    location / {
        proxy_pass https://rsp-main.tailebc04e.ts.net/;   # реальное имя ноды (резолвится)
        proxy_ssl_verify off;
        proxy_ssl_server_name on;
        proxy_set_header Host deaggr.kravchenko.cloud;     # = ingress.host → роутинг по Host
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
    }
}
